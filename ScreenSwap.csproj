<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ScreenSwap</AssemblyName>
    <RootNamespace>ScreenSwap</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Authors>ScreenSwap</Authors>
    <Description>双屏主显示器快捷切换工具</Description>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- 本项目是 WPF 主程序，DPI 感知由 app.manifest 配置，WinForms 分析器的建议不适用 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- 同时启用 WPF 与 WinForms 时，SDK 会自动加入两个全局 using，
       造成 Application / TextBox / Brush 等类型名冲突，这里移除并由代码显式引用。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
